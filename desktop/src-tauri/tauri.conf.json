{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCite",
  "version": "0.7.0-dev.0",
  "identifier": "dev.zgbrenner.autocite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "AutoCite",
        "width": 1440,
        "height": 920,
        "minWidth": 820,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first legal citation word processor",
    "longDescription": "AutoCite reviews and repairs supported legal citations while preserving the source document and keeping deterministic validation in control.",
    "copyright": "Copyright © 2026 Zachary Brenner",
    "externalBin": ["binaries/autocite-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
